# Copy to .env (git-ignored) and fill in. Never commit real values.

# Jev API key, used by the local probe (E5, `npm run probe`) and by spikes that call Jev.
JEV_API_KEY=

# The throwaway Gmail test account used by spikes (written as <test-account>
# everywhere else). The spike runner refuses to act on any other account.
GMAIL_EMAIL=

# Spike runner (spikes/run.mjs, spikes/auth.mjs). See spikes/README.md,
# "Running spikes automatically". The same five values (with GMAIL_EMAIL)
# are secrets in the spike-account GitHub environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Written by `node spikes/auth.mjs`.
SPIKE_REFRESH_TOKEN=
# Written by `node spikes/run.mjs setup` (or copied from the editor's Project Settings).
SPIKE_SCRIPT_ID=

# The ID of the standard Cloud project attached to the pilot's Apps Script project.
# Used only for `gcloud logging read` during the v1 pilot (docs/pilot.md).
# Never publish it.
PILOT_GCP_PROJECT=

# The absolute path of the pilot's config.yaml (the one that was pushed to the
# pilot account).
PILOT_CONFIG=
